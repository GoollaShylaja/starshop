{% extends 'base.html.twig'%}

{# {% block title %} Welcome to starshop {% endblock %}  // to override parent behaviour #}
{% block title %} {{ parent() }} starshop {% endblock %}

{% block body %}

<h1>Hi, Welcome to Starshop</h1>

<div>
    {# This is a comment in Twig #}
    {# {{ }}-> this is say something or print something#}
    Browse through {{ numberOfStarshipCount }} starships!

    {% if numberOfStarshipCount > 400 %}
    <p>
        That's a shipload of ships
    </p>
    {% endif %}
</div>

<div>
    <h2>My Ship</h2>
    <table>
        <tr>
            <th>Name</th>
            <td>{{ myShip.name }}</td>
        </tr>
        <tr>
            <th>Class</th>
            <td>{{ myShip.class }}</td>
        </tr>
        <tr>
            <th>Captain</th>
            <td>{{ myShip.captain |upper|lower|title }}</td>
        </tr>
        <tr>
            <th>Status</th>
            <td>{{ myShip.status }}</td>
        </tr>
    </table>
</div>
{% endblock %}